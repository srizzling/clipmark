#!/bin/sh
# Thin curl wrapper around the clipmark publish API.
#
#   export CLIPMARK_URL=http://notes.example:8080
#   export CLIPMARK_TOKEN=...            # only if the server has one set
#
#   clipmark publish doc.md [remote/path.md] [slug]   # create or update (versioned)
#   clipmark list
#   clipmark get remote/path.md
#   clipmark history remote/path.md
#   clipmark rm remote/path.md
#   clipmark export [remote/path.md ...]              # zip of the Markdown; no paths = every note
#   clipmark review remote/path.md [open|resolved|all] # reviewer's comments as Markdown, with source lines
#   clipmark comments remote/path.md [open|resolved|all]  # the same as JSON
#   clipmark resolve remote/path.md c1 [what you changed] # mark a comment done; reopen undoes it
#   clipmark slop [open|resolved|all] [json]          # every slop flag across all notes, grouped by pattern
set -eu

: "${CLIPMARK_URL:?set CLIPMARK_URL to the server base URL}"
auth=""
if [ -n "${CLIPMARK_TOKEN:-}" ]; then
  auth="Authorization: Bearer ${CLIPMARK_TOKEN}"
fi

base="${CLIPMARK_URL%/}"
cmd="${1:-}"
[ -n "$cmd" ] && shift || true

req() {
  # req METHOD PATH [curl args...]
  method="$1"; p="$2"; shift 2
  if [ -n "$auth" ]; then
    curl -fsS -X "$method" -H "$auth" "$@" "$base$p"
  else
    curl -fsS -X "$method" "$@" "$base$p"
  fi
}

case "$cmd" in
  publish|push|put)
    file="${1:?usage: clipmark publish <file.md> [remote/path.md] [slug]}"
    remote="${2:-$(basename "$file")}"
    q=""; [ -n "${3:-}" ] && q="?slug=$3"
    req PUT "/api/notes/$remote$q" -H 'Content-Type: text/markdown' --data-binary "@$file"
    echo
    ;;
  list|ls)
    req GET "/api/notes"; echo ;;
  get|cat)
    req GET "/raw/${1:?usage: clipmark get <remote/path.md>}" ;;
  history|versions)
    req GET "/api/notes/${1:?usage: clipmark history <remote/path.md>}/versions"; echo ;;
  rm|delete)
    req DELETE "/api/notes/${1:?usage: clipmark rm <remote/path.md>}"; echo ;;
  export|zip)
    # Selected notes as a zip on stdout, or every note when no paths are given.
    #   clipmark export a.md team/b.md > notes.zip
    q=""
    for p in "$@"; do
      q="$q${q:+&}path=$(printf '%s' "$p" | sed 's/ /%20/g')"
    done
    req GET "/export${q:+?$q}"
    ;;
  review)
    req GET "/api/notes/${1:?usage: clipmark review <remote/path.md> [open|resolved|all]}/comments?format=md&status=${2:-open}"
    ;;
  comments)
    req GET "/api/notes/${1:?usage: clipmark comments <remote/path.md> [open|resolved|all]}/comments?status=${2:-open}"; echo ;;
  resolve)
    p="${1:?usage: clipmark resolve <remote/path.md> <id> [what you changed]}"; id="${2:?usage: clipmark resolve <remote/path.md> <id> [what you changed]}"
    note="$(printf '%s' "${3:-}" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n\t' '  ')"
    req PATCH "/api/notes/$p/comments/$id" -H 'Content-Type: application/json' -d "{\"status\":\"resolved\",\"resolution\":\"$note\"}"; echo ;;
  slop)
    # Text flagged as AI-sounding, from every note: the quote, the feedback, the pattern.
    fmt="format=md"; [ "${2:-}" = json ] && fmt=""
    req GET "/api/slop?status=${1:-all}${fmt:+&$fmt}"; echo ;;
  reopen)
    req PATCH "/api/notes/${1:?usage: clipmark reopen <remote/path.md> <id>}/comments/${2:?usage: clipmark reopen <remote/path.md> <id>}" -H 'Content-Type: application/json' -d '{"status":"open"}'; echo ;;
  *)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
